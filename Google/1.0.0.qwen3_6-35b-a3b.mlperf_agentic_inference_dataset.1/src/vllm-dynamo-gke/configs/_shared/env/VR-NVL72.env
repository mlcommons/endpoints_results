# Server environment common to every VR-NVL72 point (Rubin). Only values that differ
# from the vLLM defaults at VR_NVL72_VLLM_COMMIT. Each point's server.yaml SERVER_ENV adds its point-specific lines;
# server.sh writes this file followed by those lines to the run's server.env and refuses a key that appears twice.
DYNAMO_ROUTER_MODE=least-loaded
# Dynamo 1.4.2 frontend request-plane acknowledgement timeout, seconds (default 5, lib/runtime tcp_client.rs). With
# migration off, a frontend stall longer than this fails the request (HTTP 500); infra only, no benchmark effect.
DYN_TCP_REQUEST_TIMEOUT=30
VLLM_MTP_DRAFT_LM_HEAD_MXFP8=1
GS2_ROUTE=1
VLLM_FI_SM107_MOE_PDL_MAX_TOKENS=1024
VLLM_MTP_DRAFT_PREFILL_PRUNE=1
VLLM_GDN_PREFILL_CHECKPOINT=1
VLLM_MAMBA_PIN_OWN_CKPT=1
VLLM_MAMBA_DROP_SUPERSEDED_STATE=1
FEH=1
VLLM_KF_PREFILL_ATTN=1
VLLM_GC_FREEZE_ADMIT=1
VLLM_GC_FREEZE_ADMIT_FRONTEND=1
VLLM_GDN_HOST_TRIM=1
VLLM_STAGED_WRITE_CHUNKED=1
LCD_FI_OVERLAY=1
PFWS=1
VLLM_MTP_DRAFT_LM_HEAD_MXFP8_MAX_M=128
VLLM_ROWDOT_PDL=1
VLLM_GDN_MTP_CUDA_PDL=1
VLLM_GDN_BA_LATE_JOIN=1
VLLM_GDN_MTP_CUDA_TUNE=RS=1+PF=212
VLLM_GDN_HOST_TRIM2=1
VLLM_PROMPT_TOKEN_ARRAY=1
# Retained from qwen-latest (low regression risk)
VLLM_FEH_MEMO=1
VLLM_GDN_HOST_TRIM3=1
VLLM_KV_COW_LAYOUT_CACHE=1
VLLM_SUFFIX_TOKEN_STAGING=256
# Integrated feature set
VLLM_GDN_BA_LATE_CAPTURE=1
VLLM_GDN_MTP_FUSED_QUANT=1
LCD_FI_PREWAIT=1
LCD_FI_PREWAITS=1
LCD_FI_PREWAIT_STAGES=4
VLLM_GLUE_PDL=1
VLLM_DRAFT_ONE_GRAPH=1
VLLM_FLASHINFER_MXFP8_K64=0
